# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Cashier sign-in OTP (server functions in /server, /api and /netlify/functions) ---
# Set these in your Netlify / Vercel project settings (NOT in the browser code).
# OTP_SECRET: any long random string (32+ characters). Generate one with: openssl rand -hex 32
OTP_SECRET=""
# SMS provider option 1 - Infobip (used if both providers are set). Find the base URL and
# API key in your Infobip portal. Base URL looks like: xxxxx.api.infobip.com
INFOBIP_BASE_URL=""
INFOBIP_API_KEY=""
# Optional sender name shown on the SMS
INFOBIP_SENDER=""

# SMS provider option 2 - Africa's Talking (https://africastalking.com). Use username "sandbox" while testing.
AT_USERNAME=""
AT_API_KEY=""
# Optional approved sender name shown on the SMS
AT_SENDER_ID=""
# Local development only: print the code in the server log when SMS is not configured
# OTP_DEV_LOG="true"

# --- Hosted database (Supabase) - used once the app is moved over (see docs/SUPABASE_MIGRATION.md) ---
# Browser settings. The switch stays OFF (unset) until every area is converted and data is imported.
# VITE_USE_SUPABASE="true"
VITE_SUPABASE_URL="https://jnyommgrfooxprzmagrw.supabase.co"
VITE_SUPABASE_ANON_KEY=""   # the PUBLIC "anon" key (Project Settings -> API)

# Server settings for /api/auth/* (Netlify / Vercel project settings only, never in the browser code).
SUPABASE_URL="https://jnyommgrfooxprzmagrw.supabase.co"
SUPABASE_ANON_KEY=""
# SECRET: bypasses all access rules. Server only. Never put it in a VITE_ variable.
SUPABASE_SERVICE_ROLE_KEY=""
